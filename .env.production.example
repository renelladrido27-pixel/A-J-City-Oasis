# Production settings for the hosted A&J CITY OASIS system.
# Copy to .env on the server and fill in the blanks. NEVER commit the filled-in copy.

APP_NAME="A&J CITY OASIS"
APP_ENV=production
# Generate on the server with: php artisan key:generate
APP_KEY=
APP_DEBUG=false
# The public https address, e.g. https://ajoasis.com (no trailing slash)
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# From the hosting control panel's MySQL section
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Only send the login cookie over https
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Real-time notifications (same Pusher app as local is fine for the demo)
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

# Gmail SMTP with an app password (Google Account > Security > App passwords)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ajoasis.system@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="ajoasis.system@gmail.com"
MAIL_FROM_NAME="A&J CITY OASIS"

# Xendit TEST mode only (xnd_development_ key) — the client approved demo
# payments, never live ones.
XENDIT_SECRET_KEY=
XENDIT_FAKE_MODE=false
# Xendit dashboard > Settings > Webhooks > "Verification token". Set the invoice
# webhook URL there to: {APP_URL}/api/webhooks/xendit
XENDIT_CALLBACK_TOKEN=
